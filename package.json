{
	"name": "jet-vscode",
	"displayName": "Jet",
	"description": "Jet programming language support for VS Code",
	"version": "0.0.4",
	"publisher": "Saffage",
	"license": "MIT",
	"icon": "images/icon.png",
	"main": "./out/extension.js",
	"repository": {
		"type": "git",
		"url": "https://github.com/Saffage/jet-vscode"
	},
	"engines": {
		"vscode": "^1.81.0"
	},
	"categories": [
		"Programming Languages"
	],
	"activationEvents": [
		"workspaceContains:*.jet"
	],
	"contributes": {
		"snippets": [
			{
				"language": "jet",
				"path": "snippets/jet.json"
			}
		],
		"languages": [
			{
				"id": "jet",
				"aliases": [
					"Jet",
					"jet"
				],
				"extensions": [
					".jet"
				],
				"configuration": "jet-cfg.json",
				"icon": {
					"light": "images/logo.svg",
					"dark": "images/logo.svg"
				}
			},
			{
				"id": "jem",
				"aliases": [
					"JEM",
					"jem"
				],
				"extensions": [
					".jem"
				],
				"configuration": "jem-cfg.json"
			},
			{
				"id": "jet-injection"
			}
		],
		"grammars": [
			{
				"language": "jet",
				"scopeName": "source.jet",
				"path": "syntaxes/jet.tmLanguage.json"
			},
			{
				"language": "jet-injection",
				"scopeName": "markdown.jet.codeblock",
				"path": "syntaxes/jet-markdown.tmLanguage.json",
				"injectTo": [
					"text.html.markdown"
				],
				"embeddedLanguages": {
					"meta.embedded.block.jet": "jet"
				}
			},
			{
				"language": "jem",
				"scopeName": "source.jem",
				"path": "syntaxes/jem.tmLanguage.json"
			}
		],
		"commands": [
			{
				"category": "Jet",
				"title": "Restart Language Server",
				"command": "jet.restartLanguageServer"
			},
			{
				"category": "Jet",
				"title": "Enable Language Server",
				"command": "jet.enableLanguageServerLocally"
			},
			{
				"category": "Jet",
				"title": "Disable Language Server",
				"command": "jet.disableLanguageServerLocally"
			}
		],
		"configuration": [
			{
				"type": "object",
				"title": "Jet",
				"properties": {
					"jet.path": {
						"type": "string",
						"description": "A path to the Jet executable. By default, the extension looks for `jet` in the PATH, but if set, will use the path specified instead.",
						"default": null
					},
					"jet.enableLanguageServer": {
						"type": "boolean",
						"description": "Enable the Jet language server.",
						"default": true
					},
					"jet.languageServerArgs": {
						"type": "array",
						"description": "Specify executable arguments",
						"default": [
							"language-server"
						]
					}
				}
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -b",
		"watch": "tsc -b -w"
	},
	"dependencies": {
		"vscode-languageclient": "^9.0.0"
	},
	"devDependencies": {
		"@types/vscode": "^1.75.1",
		"@types/node": "^22.0.0",
		"typescript": "^5.3.3"
	}
}
